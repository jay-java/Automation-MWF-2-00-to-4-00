package core;

class Followers {
	int id;
	String name;
	String address;
	long contact;

	Followers(int id, String name, String address, long contact) {
		this.id = id;
		this.name = name;
		this.address = address;
		this.contact = contact;
	}

	@Override
	public String toString() {
		return "id : " + id + " name : " + name + " address : " + address + " contact : " + contact;
	}

}

public class P025_ListPractical {
	public static void main(String[] args) {
		Followers f1 = new Followers(1, "darshan", "kalol",987654321);Followers
		Followers f2 = new Followers(2, "darshan", "kalol",987654321);Followers
		Followers f3 = new Followers(3, "darshan", "kalol",987654321);Followers
		Followers f4 = new Followers(4, "darshan", "kalol",987654321);Followers
	}
}
