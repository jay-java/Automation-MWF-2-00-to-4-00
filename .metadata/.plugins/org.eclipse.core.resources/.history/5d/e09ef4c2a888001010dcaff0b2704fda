package core;
class User{
	
	int i ;
	String name;
	User(){
		System.out.println("defualt cons in User class");
	}
//	
	User(int i){
		this.i = i;
		System.out.println("parameterized cons in User class : "+i);
	}
	
	User(int i,String name){
		System.out.println("i = "+i+ " name = "+name);
	}
	
	public void callData() {
		System.out.println("call in user class : "+i);
	}
	
}
public class P014_Constructor {
	public static void main(String[] args) {
		User u = new User();
//		u.call();
		User u1= new User(12);
		u1.callData();
		
		User u2 = new User(12, "java");
	}
}
