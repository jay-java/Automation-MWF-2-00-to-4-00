class Parent{
	Parent(){
		System.out.println("default cons in Parent");
	}
	public void call() {
		System.out.println("call in parent");
	}
	public void show() {
		System.out.println("show in parent");
	}
}
class Child extends Parent{
	public void call() {
		super.call();
		System.out.println("call in child");
	}
//	public void show() {
//		System.out.println("show in child");
//	}
}

public class P017_Polymorphism {
	public static void main(String[] args) {
		Overload o = new Overload();
		int res1 = o.add(1, 2);
		System.out.println("res 1 : " + res1);
		int res2 = o.add(1, 2, 3);
		System.out.println("res 2 : " + res2);
		int res3 = o.add(1, 2, 3, 4);
		System.out.println("res 3 : " + res3);
		
		
		Child c = new Child();
		c.call();
		c.show();
	}
}
